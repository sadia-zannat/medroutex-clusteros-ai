# MedRouteX local pilot configuration. Copy to .env.local; never commit secrets.

# Optional local SQLite persistence (Node.js 24 recommended)
MEDROUTEX_SQLITE_ENABLED=false
MEDROUTEX_SQLITE_PATH=.data/medroutex.sqlite

# Optional email alert channel using Resend
EMAIL_ALERTS_ENABLED=false
RESEND_API_KEY=
ALERT_EMAIL_FROM=MedRouteX <alerts@example.com>
ALERT_EMAIL_TO=
ALERT_EMAIL_RADIOLOGY=
ALERT_EMAIL_HOSPITAL_ADMIN=
ALERT_EMAIL_INFRASTRUCTURE=
ALERT_EMAIL_ICU=
ALERT_EMAIL_SECURITY=
APP_BASE_URL=http://localhost:3000
EMAIL_ALERT_WARNING_ENABLED=false
EMAIL_ALERT_RECOVERY_ENABLED=false
